# Copy to .env and adjust as needed. Never commit real secrets.

# ── Provider selection ────────────────────────────────────────────────────────
# "openai" (default) routes to OpenRouter; "ollama" uses a local Ollama server.
EXTRACTION_PROVIDER=openai

# ── OpenRouter (default provider) ────────────────────────────────────────────
# Required when EXTRACTION_PROVIDER=openai. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Ollama (local provider) ───────────────────────────────────────────────────
# Required when EXTRACTION_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
